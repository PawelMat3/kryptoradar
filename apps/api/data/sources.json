    "match": { "host": "devhub.test" },
    "category": "OWN_PROFILE",
    "kind": "profile",
    "nameSelector": "[itemprop=name]"
  },
  {
    "id": "jan-testowy-site",
    "name": "Strona osobista jan-testowy.test (syntetyczna)",
    "demo": true,
    "match": { "host": "jan-testowy.test" },
    "category": "PERSONAL_SITE",
    "kind": "site"
  },
  {
    "id": "p2pmarket",
    "name": "P2P Market (syntetyczny serwis ogłoszeń)",
    "demo": true,
    "match": { "host": "p2p.test" },
    "category": "P2P_LISTING",
    "kind": "listing",
    "segments": { "selector": ".listing", "author": ".seller", "content": ".body" }
  },
  {
    "id": "cryptoforum",
    "name": "KryptoForum (syntetyczne forum)",
    "demo": true,
    "match": { "host": "forum.test" },
    "category": "FORUM_POST",
    "kind": "forum",
    "segments": { "selector": ".post", "author": ".author", "content": ".content" },
    "overrides": [{ "pathPrefix": "/thread/giveaway", "category": "MASS_COMMENT" }]
  },
  {
    "id": "tgpreview",
    "name": "Telegram – publiczny kanał (syntetyczny)",
    "demo": true,
    "match": { "host": "tg.test" },
    "category": "MESSENGER_SETTLEMENT",
    "kind": "messenger",
    "segments": { "selector": ".msg", "author": ".from", "content": ".text" }
  },
  {
    "id": "gamehub",
    "name": "GameHub (syntetyczny serwis gier)",
    "demo": true,
    "match": { "host": "gamehub.test" },
    "category": "OWN_PROFILE",
    "kind": "profile",
    "nameSelector": "[itemprop=name]"
  }
