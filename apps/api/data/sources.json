[
  { "id": "github-gist", "name": "GitHub Gist", "match": { "host": "gist.github.com" }, "category": "CODE_REPOSITORY", "kind": "profile" },
  {
    "id": "github",
    "name": "GitHub",
    "match": { "host": "github.com" },
    "category": "OWN_PROFILE",
    "kind": "profile",
    "adapter": "github-api",
    "nameSelector": "[itemprop=name]"
  },
  { "id": "gitlab", "name": "GitLab", "match": { "host": "gitlab.com" }, "category": "OWN_PROFILE", "kind": "profile" },
  { "id": "keybase", "name": "Keybase", "match": { "host": "keybase.io" }, "category": "OWN_PROFILE", "kind": "profile" },
  { "id": "hackernews", "name": "Hacker News", "match": { "host": "news.ycombinator.com" }, "category": "FORUM_POST", "kind": "profile" },
  { "id": "telegram", "name": "Telegram (publiczny podgląd)", "match": { "host": "t.me" }, "category": "MESSENGER_SETTLEMENT", "kind": "profile" },
  { "id": "reddit", "name": "Reddit", "match": { "host": "www.reddit.com" }, "category": "FORUM_POST", "kind": "profile" },
  { "id": "wayback", "name": "Internet Archive (Wayback)", "match": { "host": "web.archive.org" }, "category": "UNKNOWN_WEB", "kind": "archive" },

  {
    "id": "devhub",
    "name": "DevHub (syntetyczny serwis programistyczny)",
