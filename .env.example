POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=radar

# Demo działa zawsze. Live = prawdziwe źródła.
RADAR_LIVE_ENABLED=false

# Hosty dostępne dla API (prefiks "*." dozwolony).
EGRESS_ALLOWLIST=*.test,osint-worker,mock-osint,github.com,api.github.com,gist.github.com,gitlab.com,keybase.io,news.ycombinator.com,hacker-news.firebaseio.com,t.me,eth.blockscout.com,mempool.space,web.archive.org
# true = strony z wyników wyszukiwania z dowolnego publicznego hosta (adresy prywatne zawsze blokowane).
EGRESS_OPEN_WEB=false

MAIGRET_LIVE_SITES=GitHub,GitLab,Keybase,HackerNews,Telegram,Reddit
SEARXNG_SECRET=change-me
# Opcjonalnie: wyższy limit API GitHub.
GITHUB_TOKEN=

# Opcjonalnie: API zgodne z OpenAI (Ollama, vLLM…). Puste = wyłączone.
LLM_BASE_URL=
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=

WEB_PORT=8080
